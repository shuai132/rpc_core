{
  "name": "@rpc-core/js",
  "version": "0.1.0",
  "description": "JavaScript and TypeScript SDK for rpc_core in browser and Node environments",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test dist-test/test/rpc.test.js",
    "test:rpc": "npm run build:test && node dist-test/test/rpc.js",
    "test:rpc-s": "npm run build:test && node dist-test/test/rpc_s.js",
    "test:rpc-c": "npm run build:test && node dist-test/test/rpc_c.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT"
}
